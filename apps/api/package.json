{
  "name": "@leadpilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node --import ./dist/tracing.js dist/main.js",
    "start:worker": "node --import ./dist/tracing.js dist/worker.js",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@leadpilot/shared": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "openai": "^7.41.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist"
  ]
}
