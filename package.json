{
  "name": "leadpilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @leadpilot/shared run build && pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @leadpilot/shared run build && pnpm -r run test",
    "test:integration": "pnpm --filter @leadpilot/api run test:integration",
    "eval": "pnpm --filter @leadpilot/api run eval",
    "dev": "pnpm -r --parallel --filter ./apps/* run dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
