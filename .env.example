# --- Copy to .env. Everything works without any API keys (mock LLM + mock CRM). ---

# Demo API keys created by the seed step. Dev-only placeholders: change them.
DEMO_ADMIN_KEY=lp_dev_admin_change_me
DEMO_OPERATOR_KEY=lp_dev_operator_change_me
DEMO_AGENT_KEY=lp_dev_agent_change_me

# LLM: mock | anthropic | openai
LLM_PROVIDER=mock
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint (vLLM, Ollama, ...)
EMBEDDINGS_PROVIDER=hash      # hash | openai
# Make the mock model answer invalid JSON first, to see retry-with-error in metrics
MOCK_LLM_INVALID_FIRST_ATTEMPT=false

# CRM: mock | bitrix24 | amocrm
CRM_PROVIDER=mock
# BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxx/
# BITRIX24_RESPONSIBLE_ID=1
# AMOCRM_BASE_URL=https://your-subdomain.amocrm.ru
# AMOCRM_ACCESS_TOKEN=

# Telegram channel (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TENANT=demo

# Observability (optional): send traces to an OTLP endpoint, e.g. the Jaeger from the `observability` profile
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
